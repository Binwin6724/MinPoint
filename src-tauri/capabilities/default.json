{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Narrow permissions for InputFlow windows. Native operations go through InputFlow's own typed commands only.",
  "windows": ["main", "overlay"],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "core:event:default"
  ]
}
